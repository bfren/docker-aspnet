        "8-x64-aspnet" => "7398a902ffb2eb1885b31ada4bc77521150918ea14f66cbbc7a1d15d7a42b9ece6154cdf605897844606902f6746e4d23e5f510ee0075f19563dd6175815abb3"
        "9-arm-aspnet" => "f4000e6e3fc7dfe54cef862d3eaa183e20058ed7ce535a8a12a2d6a2707369b47abc9e893d822ab78ea209d5b3229ace48679a88442a2ac903cbae1930be28fe"
        "9-arm64-aspnet" => "d1f0a8a04b92c6770a6e337713180e1f8eb1564e17334c26025fe13a0d3f8d5ba68e113a4554c96eff55771f69a89dc84561e13d12d17e8ea76ff237419d39e2"
