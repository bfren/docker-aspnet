        "10-x64-dotnet" => "d70519bc8d17f5c1c934f81997fb693e99bfcfa39fb4d4a6999dc4c5c04904548d8695cec1d58e18223d7808d988541ecab28dc1383ac95c50656d1e024f89b6"
        "11-arm-dotnet" => "f311e561615b6216b67c61cb959a87b383710b64b9fccbc16aa7a25090aaf2c77ba26ab0a9922a295ab1d3565f54c70328511cc693974c3173fb10193cb287b3"
        "11-arm64-dotnet" => "77f1c367553279c8bf5b481209ac613b3ff39b871f861998b5b926af0a37c7c92f095556f41ccdc59a7e5c607280a760710430525dbb135e6483f1c015ebd78c"
        "11-x64-dotnet" => "9965c0d8a315c5dab4172d08269f8c1d248d4286f12a646843e1d56244a0bb3056fafa16de24dce9de2fdaa53cbd16eed08c0bedc8ff78e7cb1d93c855d76c50"
        "8-arm-aspnet" => "4b039b4082991e0e24910a014847da0ee33532c7bdeb61aeb1549b24b8f37246c92124c8c09896973d09d346bddf01af0c6078481efff26a6e18d28727cf50cc"
        "8-arm64-aspnet" => "e1e65c5c0c65108f426a0af0b481b178afd165e15ba6dc0b9ac7afcbc2c4d04646c71a3216a80b815f425a182fd16051da6c0081c7f4a7afc6d38e91ede2e62c"
        "8-x64-aspnet" => "cfd81c6abe088b722f4b75cfff88a3fdf161ebf6edd00a450de3045c7014bc702d2ef9bf135ecd4de6ad23776a7957a842b8cbaa8ee64a8b023a49e5d9bfa63d"
        "9-arm-aspnet" => "0bdac16d1023ee828dfe27db647701e80aa25fae7dd3e5f79336b6e3be7ad6137544b63e3fa0a33d014940d738e710e8f3dbe3d8e974bd20e3966a7aa89e049d"
        "9-arm64-aspnet" => "53d3d8d8239717cb047054f0438045216be805704dc3ba262bea74a25d244a7f4a79971f3d30103f4f292eacdbb41ea1826c70286cd28cd3dd0893808c94e5a1"
        "9-x64-aspnet" => "0be26567f04606dd3a023a066587ad5b1f498335abe3a14b3f8187b9bcbce6fe3e8cc60304ba043f252d111e2158f46462fd3e47c37614442d76c3cbd870909a"
        "10-arm-aspnet" => "a1caec1a79a68cbe58569c40dcff9207fa29d85f90c87024ed1c04234753d10d88188b40df5bfd45bda042536f031114c8d218ecab65d005612f2f09e9392a49"
