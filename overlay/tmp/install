        "8-x64-aspnet" => "c9fb731d94a485886378fced8e64e16e999f4960891df8fe2bbfd586df06200048b8f4248ff4c5bdd357ee93dceed4c9b2551d78e36137fac560ab24b9cd1596"
        "9-arm-aspnet" => "7fd287413c753da1e1d4554b68494c15ec3693ed69b26e6270337ba6293efaeb2e158b19fc6f9ebb80918565b63bbdae082d6f990310e7ab6961cd87e8b5d4ca"
        "9-arm64-aspnet" => "a834dc1d50184f9651e801dada456d49d62f7f4acb6e7d73df96c5dfc043797735668c64b697c0fda8104eb2764e6dd247d3c62789dfa9675e258a3b7b39f3c6"
        "9-x64-aspnet" => "8c1b78fd2473ad6aa6d6af2e9b99ce405677c6ac82af4ce9ce3d1cbded8b3fa30edf82adb3b1712399d8378f480adc3ad2a029b5d174156d41962f594e0c66d9"
        "10-arm-aspnet" => "ccff26d459435511ef5490bf2d18bb4e2374576500f3b096c44c6420eebf772c3acdfd048da20d47acf065fd7d499329b504016969b9171fc50bb0c663d87ff8"
        "10-arm64-aspnet" => "1d0a7964f4a30f4d15c75cc30cb0d22e6f147031afaa53b8e41b6c6b3f7f8670dca7208eb9449bfbb306bc097bafdb705b843fff13b7d5854c23b74dd985adfc"
        "10-x64-aspnet" => "52aecf541154450e09856404552a4d5b903650472dcdc5d56e3f6459117e892fc2799d2e008fff011f1161303f414db8eb7eb3cb607af0e16720a91b2c4bed54"
        "11-arm-aspnet" => "5453d6d834fbf014885e34aeba2b04388a6f917f7ed148a954a419bfdfbb9253056e27c7a18ead64b47ae2c62106678bb7071c5230bb88c48a67e8e82b08d064"
        "11-arm64-aspnet" => "2f322e41797f5686679e4e71d40bfb7937efb46c0368bba4a7c2635657b544cfe18c49b75726d3d2fb10f6ebf45cdc794808468fe7d399b3443f3611f84f9c4c"
        "11-x64-aspnet" => "baed09cedf748d0911d14c53099ca7b323cb7b4a39e3d4a1183dcca11e709ab7e9f8eee9f809c801f684d09ac89f76860358e9cbc3fb8e75168aaf1686c72210"
        _ => { bf write error $"Unsupported .NET download: ($filename)." }
    }

    # verify downloaded file
    bf write $" .. verifying ($filename) download." install/download
    { $"($hash)  ($filename_with_ext)" | ^sha512sum -c - } | bf handle -f {|code, err|
        bf write error $" .. checksum did not match for ($filename)." install/download
    } install/download

    # return filename with extension
    $filename_with_ext
}
