        "10-x64-dotnet" => "b6e1855b3ece331d6d5b1daf4ed0a209931b8527ece85eff6d843ff3e6bccd4bc8b0c484cada7832a453cf9130e8fe83df961f129fcf4e61199ad701814039f0"
        "11-arm-dotnet" => "06ecda77c3609966dcff1ca2ac160b4f5204b7af7e354e6bf91e157951cb1999828f4edb6599ae49fad813df2a17579a2a9b48a1df4929a74d3624d299547841"
        "11-arm64-dotnet" => "b7e695e348260707024ac1ec89ce44be4ae501e3e1e5fd7ad73ec88e6be62b27abaf3f3e315a425d6446571be18a75611faaac2c3ad0748be3f0252d6aa2a6ff"
        "11-x64-dotnet" => "17c51c9633d283607c9a823f237952894439f7a628be5d91b75dbba0400e3acc0fc4131d4681cbfb5327448c8f1a0d738885f9f75cb7bdc15de3b6e758bba9ad"
