        "10-x64-dotnet" => "0a532fb8b91fd7e3458a414a83b9b0a8904374fb459de8df8a988e81ac1ac56b8f56f68a62803b77b9afed5bbdebac0b21aa4d0007fbc6ae6900be4893b4f2cf"
        "11-arm-dotnet" => "bf03756993cb520684a597105235f8e4115c8eee8d38d5509e50529083b52b031aec5c1813cd41eebb9991e65ef33b0ee3c8a51a43057027043400d938dbbb37"
        "11-arm64-dotnet" => "f21309001752484c99588a76b7e2939147f0d183fb1173c322ff9405c2cb64bcd8134a5a6eac5361f399aaad841edf366054e57af2558da1156ae53285e54da0"
        "11-x64-dotnet" => "76f6389a5282155a0b2e86e5dd9445dbc8107b090291f12d85be4d9d4c147d5ada37f687f4f8ef67f5a40432c3adfed8f18f53723a807224d31c8c8963e40264"
        "8-arm-aspnet" => "2cb865e07643fa523fa9a8d4448bf7e8ab32fe26283ef8964141360403d86863e544c3ec1df47077fa6de5d2e2667c6c97037617fe2667292d67b4b7bed6c711"
