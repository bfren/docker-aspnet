        "10-arm-aspnet" => "2b0668c52679a9a0d914d1faa15e33bc834305744a7102040a66232ca4c2e1049330b421123a89133af2f287e8ad1542642332e85d8e2d414f30cc320d247a11"
        "10-arm64-aspnet" => "a8d96e63769d48f11667bd00e21eca0197300d494a811fa8d0b9b228de2be6f83106ed8fe49be0e6b4a440a507a37dfac0efc5b7e6124e18bcccc1b2c66e3a6a"
        "10-x64-aspnet" => "a9e4b84823ec895fbdce4ece5beac9cc93b0f02c503e2679fa00a469b07dc7af4309900c8758a2ff9a1a25b2d085fb286f9a3d411783b8a1abc0bf47f51b08bc"
        "11-arm-aspnet" => "1c11b8544bd3d23949fa4a23e6dbe4d1088d2616e67035ab6d86ca5afeda1b2b418ec1ae9383e01b7d3ce6adc97092c0eb9ec9cd9a663b48d79088de53da4627"
        "11-arm64-aspnet" => "259d39d09d59250ecab81470cce91e0dea82bcf3fa649ef67decf3ad84445e28425319dcfe04e697178d78f6f8cb6da30ca6543e6983e906886b845a4cc08d6b"
        "11-x64-aspnet" => "6dbceb01378a9abcbd7704dd5cfd6ede8d58557418d6cd251797fff7e20c3d165eddd4839ebdcf820b912f1e691eaee1427f5849da3dcbb00758aa2638d63214"
        _ => { bf write error $"Unsupported .NET download: ($filename)." }
    }

    # verify downloaded file
    bf write $" .. verifying ($filename) download." install/download
    { $"($hash)  ($filename_with_ext)" | ^sha512sum -c - } | bf handle -f {|code, err|
        bf write error $" .. checksum did not match for ($filename)." install/download
    } install/download

    # return filename with extension
    $filename_with_ext
}
