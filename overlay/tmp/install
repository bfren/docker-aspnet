        "8-x64-aspnet" => "efb9998e2e0821f94fc9073f25924210bb0959ce3f5d05fb524dd67794dcc6e90fd1c7c0054e09f1b51707701da6ef21a4f4094d9b4bd3fd91dd8eb587a48cb5"
        "9-arm-aspnet" => "b1c08a96925514ffd22967727f55f986b9db758fdc2a62af07bb475d0e15bb0554329cbe051f7df649fdc9dc0914629bf2eebbf7a962a6c65a535e59a477dc0b"
        "9-arm64-aspnet" => "f00112595a443e712cb42f245e39e58c06bd8f49f09eb510ae5f6324ba636ec0a137a35bc86f7e6a5d812577f605435ce2604bb4c8aa40f5ff0c2b126c52306d"
        "9-x64-aspnet" => "d54ee0b25d8261cf41ba88433bed7f569a6771eb75a54edcc6f8f29782f891a31c961ca7c072414efa1f43b40a503095dbf4ccdba48ebf324d328b1c5911f82c"
        "10-arm-aspnet" => "df9ab650203763a8bb169dc73ca34c01221f50f9bc1c4c9933079c484e7b5b9bdf04bb35de5b59acf04320c30b92f0c9bbfb94b1f8b461df112018b6b8825d23"
        "10-arm64-aspnet" => "7a0e97caf4dea5dac0dca1ff52971a501292dae55cac384414298c398ecc4fe948f22f4bf45c5a590188769d47fc42bbc5f4e76b6a1b875fc0c895194b0e5531"
        "10-x64-aspnet" => "78b82797fddf3bf44bbdc84c7957236d60c6a7249b83820603e8482316b8e14dce1e8a2ad71c93d8f94a0a2e5b81c14df65ac9d6dec137f5db674962fca0e9f0"
        "11-arm-aspnet" => "00d5a966b701fea06b20e232bfed01c1669e251e0daff3f15316c0853f1cbb35b4d4c9e7a026fdd90cce50567efc4133a13d955054dbc44ef96baa4eb4d92326"
        "11-arm64-aspnet" => "48fd0e7dd2774b0021d845dcb32ba645fe527d757ab1e1373e14f93c6963324cea677abecc3cdce3471ef9a5fe32dab1c3a0d8674cb1e929adbacf4a8cfc6664"
        "11-x64-aspnet" => "1aec02dfa5ab8c5aca3a73b883d3f420504b48fe3ac50413fddd521918cb8b119074f5aa93ee4ff5fe3ce60867f102a523b9072e7c19820acd1f5c462381e6d4"
        _ => { bf write error $"Unsupported .NET download: ($filename)." }
    }

    # verify downloaded file
    bf write $" .. verifying ($filename) download." install/download
    { $"($hash)  ($filename_with_ext)" | ^sha512sum -c - } | bf handle -f {|code, err|
        bf write error $" .. checksum did not match for ($filename)." install/download
    } install/download

    # return filename with extension
    $filename_with_ext
}
