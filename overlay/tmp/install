        "8-x64-aspnet" => "b6496baf29a19e8576299fe6e2888eb9406857b7f52697412435c630771a93d0871e76e31c56a74aa8dd728c8047a722861befb18307fe44fdbf59a1ded3e4ce"
        "9-arm-aspnet" => "809b2ece5ee0daeffe5e00f8d102fead2b2275027993c7707377539bf18cf0358c484a5d3288e666e317dc8b2e9cba21e500221cff1393a824b3f4efa796fe23"
