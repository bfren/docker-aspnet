        "10-arm-aspnet" => "637ee3c4b193b82fe6dccb553fbcdd481a253602eba1b005fb49474020eb1906865e427610e40962d689c6fe176f9839b3647151e6866b14ce3fb33b87549ee9"
        "10-arm64-aspnet" => "c1eabdb0540974f5209a93462798d84837b9ca96ea7072404b7e571d2c7454d094902534b553bd853e8172c786c2d7fc1d22d0f8a0edca65beda443df6b32aa9"
        "10-x64-aspnet" => "2cf30883c0ba8ca1a96a1581a7072cec229a19a7dc2558c89d2aa9d9898e2cf8afea6bb8e3cf59687585c66ead7daba27fe631e241d7290fbb294425ed74c58e"
        "11-arm-aspnet" => "0b8a5adb09bf6a1e1ff80e72d423c4780e51e732d965e49d7b46fa906856c6dcafa4df5f1c69503cbf9bcd203402c7e72407daa7c75b1add40e80878b3851319"
        "11-arm64-aspnet" => "1889cb194b54c3e20b4b3da3e5ad9f64adaa839bc1ee38494c42efa65b1dcf9dfa3b4f0d01cd06dc36aabb9a6be982e3156eeea1d9f706eb7df3a62b518dd3c4"
        "11-x64-aspnet" => "8520f67bce4d1450ef603a90c25b733efa40393e6c19048ccb82d669ae8b6a589d0b732391ac3bf41955e4bd734d79d751d738b420aa5416ee83f5978b3deec6"
        _ => { bf write error $"Unsupported .NET download: ($filename)." }
    }

    # verify downloaded file
    bf write $" .. verifying ($filename) download." install/download
    { $"($hash)  ($filename_with_ext)" | ^sha512sum -c - } | bf handle -f {|code, err|
        bf write error $" .. checksum did not match for ($filename)." install/download
    } install/download

    # return filename with extension
    $filename_with_ext
}
