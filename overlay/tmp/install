        "10-x64-aspnet" => "93f88e0476ec6ff1a5e6b28f66a9a7c02574c75424aaa0ec74e7d3024347ffbc3f4e6d6796f2afc7c2c5ca352775a21486135dd9496f5f74163be0e33dac5d91"
        "11-arm-aspnet" => "a19d388369bea6fe8a32fa2f998fce6148101b8405cdb809d5042a2783ec252d8cdebb9493838fa53ec8b948e33912b58719c6298e60153fc8bfd519b5138804"
        "11-arm64-aspnet" => "21407616b3a7ac42bf4833e26079e470d7de8ca3409b3fc824a7f451a8332f8782a8442ddff4ae0ef5f9318904cf25e1862b496517f7a7c9269da47dbcfd1acd"
        "11-x64-aspnet" => "de6ab8edf7e49eb6514625affdc26dc90bb8a5ccb872c234492399bb67a726a75bd31fdebb5c79f99946e0601856c1d4dece243d907810248509592b1b37a35e"
        _ => { bf write error $"Unsupported .NET download: ($filename)." }
    }

    # verify downloaded file
    bf write $" .. verifying ($filename) download." install/download
    { $"($hash)  ($filename_with_ext)" | ^sha512sum -c - } | bf handle -f {|code, err|
        bf write error $" .. checksum did not match for ($filename)." install/download
    } install/download

    # return filename with extension
    $filename_with_ext
}
