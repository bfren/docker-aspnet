#!/usr/bin/nu

use bf

# Download URLs for .NET and ASP.NET runtimes
const dotnet_url = "https://builds.dotnet.microsoft.com/dotnet/Runtime/{v}/dotnet-runtime-{v}-linux-musl-{a}.tar.gz"
const aspnet_url = "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/{v}/aspnetcore-runtime-{v}-linux-musl-{a}.tar.gz"

# Setup and install .NET runtime and ASP.NET
def main [] {
    # add www user
    bf user add www

    # get .NET version
    cd /tmp
    let revision = bf fs read DOTNET_REVISION
    bf build add "ASP.NET" $revision

    # handle preview versions - they come with build versions that we want to strip away
    # add a line per preview, e.g. "12" => "12.0.0-rc.1.<build>"
    bf write "Stripping away preview build versions."
    let build = match ($revision | get_major) {
        _ => $revision
    }
    bf write $"Installing .NET v($revision)."

    # install dotnet dependencies
    let deps = [
        icu-libs
        libgcc
        libssl3
        libstdc++
        tzdata
    ]
    bf write "Installing .NET dependencies."
    bf pkg install $deps

    # get platform architecture
    let platform = bf build | get Platform
    let arch = match $platform {
        "linux/amd64" => "x64"
        "linux/arm/v7" => "arm"
        "linux/arm64" => "arm64"
        _ => { bf write error $"Unsupported platform: ($platform)" }
    }
    bf write $"Detected platform architecture is: ($arch)."

    # install .NET runtime
    bf write "Installing .NET runtime."
    let dotnet_file = download $build $arch dotnet $dotnet_url
    let dotnet_dir = "/usr/share/dotnet"

    try {
        bf write $" .. extracting ($dotnet_file)."
        mkdir $dotnet_dir
        ^tar -oxzf $dotnet_file -C $dotnet_dir
        ^ln -s $"($dotnet_dir)/dotnet" /usr/bin/dotnet
    } catch {
        bf write error " .. error installing .NET runtime."
    }

    # install ASP.NET runtime
    bf write $"Installing ASP.NET runtime."
    let aspnet_file = download $build $arch aspnet $aspnet_url
    let aspnet_dir = "shared/Microsoft.AspNetCore.App"

    try {
        bf write $" .. extracting ($aspnet_file)."
        ^tar -oxzf $aspnet_file -C $dotnet_dir $"./($aspnet_dir)"
    }

    if ($"($dotnet_dir)/($aspnet_dir)/($build)" | bf fs is_not_dir) {
        bf write error " .. error installing ASP.NET runtime."
    }

    # save ASP.NET directory
    bf env set ASPNET_RUNTIME $"($dotnet_dir)/($aspnet_dir)"

    # add bf-aspnet module to config
    bf config use_mod bf-aspnet
}

# Get the major version from a revision
def get_major []: string -> string { $in | split row "." | first }

# Download and verify a runtime for .NET or ASP.NET
def download [
    version: string     # Runtime verison
    arch : string       # Platform architecture
    kind: string        # Runtime kind - 'dotnet' or 'aspnet'
    url_format: string  # URL format - see constants at top of module
] {
    # build the URL and filename
    let url = $url_format | str replace --all "{v}" $version | str replace --all "{a}" $arch
    let filename = $"($version | get_major)-($arch)-($kind)"
    let filename_with_ext = $"($filename).tar.gz"

    # download the requested runtime
    bf write $" .. downloading ($url)."
    bf http download $url $filename_with_ext

    # get the relevant hash
    let hash = match $filename {
        "10-arm-dotnet" => "ec06ce564e594c2d403999ebd29d2c07d7fc6d570a9b1ab76d0768187a3b1bff384703f9edabf9a5ed226619a5fa5a831bbe996bf10c8857b9f5afaac9d434e8"
        "10-arm64-dotnet" => "847e3d3992148fa451f720a220776957c57641ddf2d7833eb9552ec266361e3c21f103867a6780796c50bbadbf8cec21c421d3bacd9f93da73d3b1e71f11b8af"
        "10-x64-dotnet" => "dca559d4265deac0a1f16f9f4e31a75f2210a71ff6f62b0131cf0dabdececca193c8a7eaf5a1bf4291b44b0afb13953b24ba1d8e58acd0bf80eb3f148c23594e"
        "11-arm-dotnet" => "dbca05e02a6c206c93d02fe7acb6ca9f8025aacca3d17b1383f25dc18b7a3c09cc2c2105d0be92b6a11273a5bb370ff6d56caeca5de0805d12a251f4a44895ca"
        "11-arm64-dotnet" => "7b32d53ee1c98078f71e73b510332aeca7a70b974f38d93201857ba8b8870e0d175f1d206b15cde03fd145e130bcf86e7c5749e67efec20ff62de0132119f7e3"
        "11-x64-dotnet" => "85e1d28610719a44119ff706bb09f17487380a47d6d0400adad72888ba2cef55e80e2566d15b2812af442ecde469d05d272e15ded04d515f628b40a5345c7854"
        "10-arm-aspnet" => "b7eccf927746eefb3315f7c52b788cede2e9b6ce04111c41524ead4c89430f1ddc5749373a88951ed7592e65c49b514ef2e1b6a53e637985a78ba9ebfbc58ad7"
        "10-arm64-aspnet" => "fc11fb386be841f4b1d84b1a95e68bb95177fad228e56e215a5cd196ef2460f3fb354c8f2f48d132aa71f676829aaf403e2f546fe5e20c2d38f097be0c64e7b9"
        "10-x64-aspnet" => "0c4608259c99236bcb860c145b8794c72c6817d01d4ed0ad2132b78cd90e13c6527341edb787b38d9e0382d806b61bfbb170b9951cec68d1043840ff176fa90b"
        "11-arm-aspnet" => "d8db74f176c2e9d0074b5ef7469565d39fd40603af26ef4342cd539dd7038ecb85bb042ec203dd9fa7c689f37f940206e2f8befebceb7593be1fec3d60fd60e8"
        "11-arm64-aspnet" => "1163ef70fc52191de898d64c3183a185d2ed0ed44fd61b512a27b8f3674f2c7b733da58e97e949135b4c72bd737799e79b019011ad49a806d970be79389e6301"
        "11-x64-aspnet" => "63df27c6da3c6e0d95e575b9b17c655e4b92b06bec1ecc9992203501d29f6f9c7258af4b31be0aaa9659b1c7d0ecff3b393fa9c80b5bfffbdf9d0b95a6280feb"
        _ => { bf write error $"Unsupported .NET download: ($filename)." }
    }

    # verify downloaded file
    bf write $" .. verifying ($filename) download." install/download
    { $"($hash)  ($filename_with_ext)" | ^sha512sum -c - } | bf handle -f {|code, err|
        bf write error $" .. checksum did not match for ($filename)." install/download
    } install/download

    # return filename with extension
    $filename_with_ext
}
